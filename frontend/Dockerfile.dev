# ── Frontend Dev Dockerfile ───────────────────────────────────────────────────
# Used only by docker-compose.dev.yml — does NOT build the app.
# Source code is bind-mounted at runtime so Vite HMR picks up all changes.

FROM node:20-alpine

WORKDIR /app

# Install dependencies (cached layer unless package files change)
COPY package.json package-lock.json ./
RUN npm ci

# Source is mounted as a volume at runtime — no COPY needed
EXPOSE 5173

CMD ["npm", "run", "dev"]
