PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/?appName=<app_name>
MONGO_DB_NAME=ai_jailbreak

# ── Session / JWT ─────────────────────────────────────────────────────────────
# SESSION_SECRET: random string used to sign team session JWTs (min 32 chars recommended)
SESSION_SECRET=
# Admin login credentials — used by POST /api/admin/login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER: "openrouter" (default), "groq", or "anthropic"
LLM_PROVIDER=openrouter

# Groq (active by default) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (swap in by setting LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenRouter (active by default)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini