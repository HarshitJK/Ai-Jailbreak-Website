# Required env vars — copy to .env and fill in values

# Port the Express server listens on
PORT=4000

# Frontend origin for CORS (e.g. http://localhost:5173 in dev)
FRONTEND_ORIGIN=http://localhost:5173

# Anthropic API key — leave empty until real Anthropic calls are wired
# TODO: fill this in during the "real LLM" pass
ANTHROPIC_API_KEY=
