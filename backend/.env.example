PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=ai_jailbreak

# Admin API secret — set the same value in frontend/.env as VITE_ADMIN_SECRET
ADMIN_SECRET=changeme

# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER: "groq" (default) or "anthropic"
LLM_PROVIDER=groq

# Groq (active by default) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (swap in by setting LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=