PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=ai_jailbreak

# Admin API secret — legacy X-Admin-Secret header (kept for backwards compat)
ADMIN_SECRET=changeme

# ── Session / JWT ─────────────────────────────────────────────────────────────
# SESSION_SECRET: random string used to sign team session JWTs (min 32 chars recommended)
SESSION_SECRET=
# Admin login credentials — used by POST /api/admin/login
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER: "groq" (default) or "anthropic"
LLM_PROVIDER=groq

# Groq (active by default) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Anthropic (swap in by setting LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=